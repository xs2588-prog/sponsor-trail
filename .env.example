# Model used by every agent (LiteLLM name). Lead/Writer can be overridden separately.
SPONSOR_MODEL=vertex_ai/gemini-3.5-flash-lite
# SPONSOR_LEAD_MODEL=
# SPONSOR_WRITER_MODEL=
# Where the cleaned parquet files live: a local folder or gs://bucket/path
SPONSOR_DATA_DIR=data/clean
# Set to 0 to hide the toy example source once the real sources work
SPONSOR_EXAMPLE_SOURCE=1
# Cloud Run only: download the cleaned parquet files from GCS at startup
# SPONSOR_GCS_URI=gs://your-bucket/clean
